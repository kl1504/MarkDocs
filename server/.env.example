PORT=4000
MONGODB_URI=mongodb://localhost:27017/markdocs
# Where your web app lives (used for payment redirects)
CLIENT_URL=http://localhost:3000

# Strongly recommended in production: protects editing. Leave empty for open local dev.
ADMIN_PASSWORD=

# Payments (optional; leave empty to disable a provider)
CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# Comma-separated origins allowed to use the editing API (/api/docs).
# Defaults to CLIENT_URL. Public docs and checkout stay open to any origin.
ALLOWED_ORIGINS=http://localhost:3000
